# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the browser reaches this app; used to build CLI verify links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMAC key for CLI tokens. Generate with: openssl rand -base64 48
CLI_JWT_SECRET=

# GitHub username that becomes the owner on first sign-in. Set this BEFORE
# anyone signs in — it is the only way the first invite gets handed out.
TOKENMAX_OWNER_GITHUB_LOGIN=
